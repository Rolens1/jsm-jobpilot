# ==============================================================================
# JobPilot - Production Environment Variables Template
# Copy this file to .env.local for local development, or populate these values
# into your Vercel Project Settings (Settings -> Environment Variables).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL & Canonical Domain
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production on Vercel: https://your-project.vercel.app (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. InsForge BaaS (PostgreSQL Database, Auth, Storage) [REQUIRED]
# ------------------------------------------------------------------------------
# The base URL of your InsForge project instance
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app

# Public client anonymous key (safe for browser exposure)
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key_here

# Optional: Server-side InsForge API / service role key for elevated backend operations
INSFORGE_API_KEY=

# ------------------------------------------------------------------------------
# 3. PostHog Product Analytics [OPTIONAL]
# ------------------------------------------------------------------------------
# Project API Key from PostHog Project Settings
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_project_token_here

# PostHog Ingestion Host (Default US cloud: https://us.i.posthog.com, EU: https://eu.i.posthog.com)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ------------------------------------------------------------------------------
# 4. Multi-Provider AI Gateways (Free LLM Ecosystem & Backups) [AT LEAST ONE RECOMMENDED]
# ------------------------------------------------------------------------------
# Primary Provider: Groq Cloud (Free high-rate Qwen 3.8 / Llama 3.3 models)
# Get key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Secondary Backup: Google Gemini (Free tier 1,500 RPD)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Tertiary Backup: Cerebras Cloud (Ultra-fast Llama inference)
# Get key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Quaternary Backup: Mistral AI
# Get key: https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Quinary Backup: OpenRouter
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ultimate Fallback: OpenAI Direct
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Job Search Provider 1: RapidAPI JSearch [RECOMMENDED]
# ------------------------------------------------------------------------------
# RapidAPI Key for JSearch aggregator
# Get key: https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# ------------------------------------------------------------------------------
# 6. Job Search Provider 2: Jooble [FALLBACK]
# ------------------------------------------------------------------------------
# Jooble Publisher API Key
# Get key: https://jooble.org/api/about
JOOBLE_API_KEY=

# ------------------------------------------------------------------------------
# 7. Job Search Provider 3: Adzuna [FALLBACK]
# ------------------------------------------------------------------------------
# Adzuna Developer Application Credentials
# Get keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ------------------------------------------------------------------------------
# 8. Company Research: Browserbase & Stagehand [OPTIONAL]
# ------------------------------------------------------------------------------
# Remote browser execution for deep company webpage scraping
# Get keys: https://www.browserbase.com/
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
